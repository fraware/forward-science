<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="#faf9f6">
  <meta name="description" content="Forward Science">
  <meta name="author" content="Mateo H. Petel">
  {% if not essay.complete %}<meta name="robots" content="noindex,follow">{% endif %}
  <link rel="canonical" href="{{ (base_url ~ '/' ~ essay.slug ~ '/') if base_url and essay.complete else essay.original_url }}">
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="Forward Science">
  {% if base_url and essay.complete %}<meta property="og:url" content="{{ base_url }}/{{ essay.slug }}/">{% endif %}
  <meta property="og:title" content="{{ essay.title }}">
  <meta property="og:description" content="{{ essay.subtitle }}">
  <meta property="article:published_time" content="{{ essay.date }}">
  <meta name="twitter:card" content="summary">
  <title>Forward Science</title>
  <link rel="icon" href="../favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="../styles.css">
  <script src="../reader.js" defer></script>
</head>
<body data-essay-slug="{{ essay.slug }}">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header"><div class="shell site-header__inner">
    <a class="wordmark" href="../" aria-label="Forward Science homepage">Forward Science</a>
    <nav class="header-nav" aria-label="Primary navigation"><a href="../#essays">All essays</a></nav>
  </div></header>
  <main id="main" class="reader">
    <header class="chapter-heading narrow">
      <p class="chapter-kicker">Part {{ essay.chapter_roman }} <span aria-hidden="true">/</span> {{ essay.concept }}</p>
      <h1>{{ essay.title }}</h1>
      <p class="chapter-subtitle">{{ essay.subtitle }}</p>
      <p class="chapter-byline">Mateo H. Petel <span aria-hidden="true">·</span> <time datetime="{{ essay.date }}">{{ essay.date_long }}</time></p>
    </header>
    <nav class="chapter-register chapter-register--essay narrow" aria-label="The six parts of Forward Science">
      <span class="chapter-register__label">The series</span>
      <ol>
      {% for part in essays %}
        <li><a href="../{{ part.slug }}/" aria-label="Part {{ part.chapter_roman }}. {{ part.title }}"{% if part.slug == essay.slug %} aria-current="page"{% endif %} title="{{ part.title }}"><span aria-hidden="true">{{ part.chapter_roman }}</span></a></li>
      {% endfor %}
      </ol>
    </nav>
    {% if essay.complete %}
    <section class="reading-tools narrow" aria-label="Reading tools">
      <details class="reader-toc">
        <summary>In this essay <span aria-hidden="true">⌄</span></summary>
        <nav aria-label="Sections of this essay">
          <ol>{% for landmark in essay.landmarks %}<li><a href="#{{ landmark.anchor }}">{{ landmark.label }}</a></li>{% endfor %}</ol>
        </nav>
      </details>
      {% if essay.audio %}
      <details class="listen-option" id="listen">
        <summary>Listen to this essay</summary>
        <div class="listen-option__body">
          <audio controls preload="none" data-essay-audio
                 src="../{{ essay.audio }}?v={{ essay.audio_sha256[:12] }}"
                 aria-label="Audio narration of {{ essay.title }}">Your browser does not support audio playback.</audio>
        </div>
      </details>
      {% endif %}
    </section>
    <div class="reading-progress" aria-hidden="true"><span></span></div>
    {% endif %}
    {% if essay.complete %}
      <article class="prose narrow" aria-label="Full essay">{{ essay.display_body | safe }}</article>
    {% else %}
      <div class="prose narrow preview-text">
        <p class="introduction__lead">{{ essay.summary }}</p>
        <p>The complete published text and its original references are available at the source publication.</p>
        <p><a class="source-action" href="{{ essay.original_url }}" target="_blank" rel="noopener noreferrer">Read the full essay on Substack <span aria-hidden="true">↗</span></a></p>
      </div>
    {% endif %}
    <div class="chapter-source narrow"><p>Originally published on <a href="{{ essay.original_url }}" target="_blank" rel="noopener noreferrer">Critical Systems <span aria-hidden="true">↗</span></a>.</p></div>
    <nav class="chapter-navigation narrow" aria-label="Essay navigation">
      <a href="{{ '../' ~ previous.slug ~ '/' if previous else '../#essays' }}" class="chapter-navigation__item"><span>{{ '← Previous essay' if previous else '← All essays' }}</span><strong>{{ previous.title if previous else 'The complete series' }}</strong></a>
      <a href="{{ '../' ~ next.slug ~ '/' if next else '../#essays' }}" class="chapter-navigation__item chapter-navigation__next"><span>{{ 'Next essay →' if next else 'All essays →' }}</span><strong>{{ next.title if next else 'The complete series' }}</strong></a>
    </nav>
  </main>
  <footer class="site-footer shell"><span>© 2026 Mateo H. Petel</span><a href="../">Forward Science ↑</a></footer>
</body>
</html>
