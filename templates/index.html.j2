<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="#faf9f6">
  <meta name="description" content="Forward Science: six essays by Mateo H. Petel on the institutions and scientific loops that turn AI into scientific progress.">
  <meta name="author" content="Mateo H. Petel">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Forward Science">
  <meta property="og:title" content="Forward Science — Mateo H. Petel">
  <meta property="og:description" content="The institutions that turn new intelligence into scientific progress.">
  {% if base_url %}<meta property="og:url" content="{{ base_url }}/"><link rel="canonical" href="{{ base_url }}/">{% endif %}
  <meta name="twitter:card" content="summary">
  <title>Forward Science — Mateo H. Petel</title>
  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header"><div class="shell site-header__inner">
    <a class="wordmark" href="./" aria-label="Forward Science homepage">Forward Science</a>
    <nav class="header-nav" aria-label="Primary navigation"><a href="#essays">Essays</a><a href="#about">About</a></nav>
  </div></header>
  <main id="main">
    <section class="hero narrow" aria-labelledby="page-title">
      <p class="eyebrow">A series in six parts</p>
      <h1 id="page-title">Forward Science</h1>
      <p class="hero__deck">The institutions that turn new intelligence into scientific progress.</p>
      <p class="hero__byline">Mateo H. Petel <span aria-hidden="true">·</span> June 2026</p>
    </section>
    <nav class="chapter-register chapter-register--home narrow" aria-label="The six parts of Forward Science">
      <span class="chapter-register__label">The series</span>
      <ol>
      {% for e in essays %}
        <li><a href="{{ e.slug }}/" aria-label="Part {{ e.chapter_roman }}. {{ e.title }}" title="{{ e.title }}"><span aria-hidden="true">{{ e.chapter_roman }}</span></a></li>
      {% endfor %}
      </ol>
    </nav>
    <section class="introduction narrow" aria-label="Introduction">
      <p class="introduction__lead">AI is expanding what researchers are able to attempt. Scientific progress depends on how institutions turn that capability into evidence, judgment, and the next experiment.</p>
      <p>The six essays follow the scientific loop, the people who strengthen it, and the institutions that support their work.</p>
    </section>
    <section id="essays" class="essays" aria-labelledby="essays-title">
      <div class="section-header"><h2 id="essays-title">Contents</h2><span>June 2026</span></div>
      <ol class="essay-list">
      {% for e in essays %}
        <li class="essay" id="part-{{ e.chapter_roman }}">
          <div class="essay__number" aria-hidden="true">{{ e.chapter_roman }}</div>
          <div class="essay__content">
            <p class="essay__concept">{{ e.concept }}</p>
            <h3><a href="{{ e.slug }}/">{{ e.title }}</a></h3>
            <p class="essay__subtitle">{{ e.subtitle }}</p>
            <p class="essay__summary">{{ e.summary }}</p>
          </div>
        </li>
      {% endfor %}
      </ol>
    </section>
    <section class="colophon narrow" id="about" aria-labelledby="colophon-title">
      <h2 id="colophon-title">Colophon</h2>
      <div class="colophon__text">
        <p>Forward Science is a series of six essays by <strong>Mateo H. Petel</strong>, first published in June 2026 in <a href="https://mateopetel.substack.com/t/forward-science" target="_blank" rel="noopener noreferrer">Critical Systems</a>.</p>
        <p>This edition brings the original essays and their references together in one place.</p>
      </div>
    </section>
  </main>
  <footer class="site-footer shell"><span>© 2026 Mateo H. Petel</span><a href="#main">Back to top ↑</a></footer>
</body>
</html>
